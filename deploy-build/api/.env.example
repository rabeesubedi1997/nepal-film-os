APP_NAME="Nepal Film OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://filmos.kitetool.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nepal_film_os
DB_USERNAME=root
DB_PASSWORD=

FRONTEND_URL=https://filmos.kitetool.com
SANCTUM_STATEFUL_DOMAINS=filmos.kitetool.com

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.filmos.kitetool.com

SANCTUM_TOKEN_EXPIRATION=1440

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="admin@filmos.kitetool.com"
MAIL_FROM_NAME="${APP_NAME}"

# For SMTP (alternative to sendmail), uncomment and configure:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.filmos.kitetool.com
# MAIL_PORT=465
# MAIL_USERNAME=admin@filmos.kitetool.com
# MAIL_PASSWORD=your-password
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS="admin@filmos.kitetool.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
